# ==============================================================================
# Vanseva — Green Earth & Plantation Management System
# Production & Docker Environment Configuration Template
# ==============================================================================

# Database Configuration (Reusing existing container on cch-network)
DB_HOST=cch-portal-mysql
DB_PORT=3306
DB_NAME=vanseva_ngo
DB_USER=cch_user
DB_PASS=cch_portal_secure_pass_2026

# Internal Nextcloud Storage Integration (Reusing cch-nextcloud container)
NEXTCLOUD_URL=http://cch-nextcloud:80
NEXTCLOUD_ADMIN_USER=cch_admin
NEXTCLOUD_ADMIN_PASSWORD=cch_admin_pass123
NEXTCLOUD_BASE_FOLDER=Vanseva

# Ports
PORT_BACKEND=8081
PORT_FRONTEND=3000

# Application Secrets
JWT_SECRET=vanseva_green_earth_ngo_session_secure_key_2026_super_secret
